# Earthfile for ROS Noetic / Ubuntu 20.04
#
# NOTE: This Earthfile was originally written for internal infrastructure.
# It references:
#   - A private Earthly base image (rios-ai/<internal_build_framework>+rios-noetic)
#   - The Arena SDK hosted on an internal S3 bucket
#   - The arena_api Python package hosted on an internal PyPI mirror
#     (pypi.org)
#   - A private Docker registry (<YOUR_REGISTRY>)
#   - A private GitHub repository (rios/camera_control_msgs)
#
# These resources are not publicly available. The file is retained for
# reference. Community users should:
#   1. Download the Arena SDK directly from https://thinklucid.com/downloads-hub/
#   2. Install arena_api from PyPI: pip3 install arena_api
#   3. Obtain camera_control_msgs from its public repository
#   4. Use a standard ROS Noetic base image (e.g., ros:noetic)

# Arguments for build
ARG CMAKE_BUILD_TYPE=Release
ARG CURRENT_REPO
ARG CURRENT_BRANCH
ARG CURRENT_COMMIT_HASH

# Replace the line below with a public ROS Noetic base image, e.g.:
# FROM ros:noetic
# FROM github.com/rios-ai/<internal_build_framework>+rios-noetic  # internal — not publicly available

base-dependencies:
    FROM +base

    RUN apt-get update && apt-get install -y --no-install-recommends \
            curl \
            unzip \
            file \
            python-is-python3 \
        && rm -rf /var/lib/apt/lists/*

    RUN curl -O https://bootstrap.pypa.io/get-pip.py && \
        python3 get-pip.py && \
        rm get-pip.py

ros-dependencies:
    FROM +base-dependencies

    RUN apt-get update && apt-get install -y --no-install-recommends \
            python${PYTHON_VERSION}-rospkg \
            python${PYTHON_VERSION}-catkin-tools \
            python${PYTHON_VERSION}-osrf-pycommon \
            ros-${ROS_DISTRO}-catkin \
            ros-${ROS_DISTRO}-image-common \
            ros-${ROS_DISTRO}-vision-opencv \
        && rm -rf /var/lib/apt/lists/*

custom-dependencies:
    FROM +ros-dependencies

    RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
        && unzip awscliv2.zip \
        && ./aws/install \
        && rm -rf aws

    # Download Arena SDK from LUCID (https://thinklucid.com/downloads-hub/)
    # The original build fetched ArenaSDK_v0.1.54_Linux_x64.tar.gz from an
    # internal S3 bucket. Replace with your own hosted copy or a direct download.
    # RUN aws --endpoint-url <YOUR_S3_ENDPOINT> s3 cp s3://<YOUR_BUCKET>/ArenaSDK_v0.1.54_Linux_x64.tar.gz . \
    #     && tar zxf ArenaSDK_v0.1.54_Linux_x64.tar.gz \
    #     && mv ArenaSDK_Linux_x64 /opt/ArenaSDK \
    #     && rm -rf ArenaSDK_v0.1.54_Linux_x64* README \
    #     && echo "/opt/ArenaSDK/lib64\n/opt/ArenaSDK/GenICam/library/lib/Linux64_x64\n/opt/ArenaSDK/ffmpeg" \
    #            >> /etc/ld.so.conf.d/Arena_SDK.conf \
    #     && ldconfig

    # Install Arena Python API from public PyPI
    RUN pip${PYTHON_VERSION} install arena_api

    # Get camera_control_msgs package
    GIT CLONE --branch develop https://github.com/rios/camera_control_msgs.git /root/catkin_ws/src/camera_control_msgs

save-source:
  LOCALLY
  SAVE ARTIFACT ../ source

copy-source:
    FROM +custom-dependencies

    COPY +save-source/* /root/catkin_ws/src/arena_camera_ros

    WORKDIR /root/catkin_ws

    RUN /bin/bash -c 'source /opt/ros/${ROS_DISTRO}/setup.bash && \
        catkin config \
        --extend /opt/ros/${ROS_DISTRO} --install --cmake-args -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} && \
        catkin build'

tag-image:
    FROM +copy-source

    # DO github.com/rios-ai/<internal_build_framework>+TAG_IMAGE --BRANCH=$CURRENT_BRANCH --REPO=$CURRENT_REPO --COMMIT=$CURRENT_COMMIT_HASH
    # Replace with your own tagging scheme.
